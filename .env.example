# Postgres connection. Local dev: podman/docker container (see README).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sail

# Optional — CoinGecko demo API key (higher rate limit for long-tail assets).
# COINGECKO_API_KEY=

# NextAuth JWT secret (required): openssl rand -base64 32
AUTH_SECRET=

# Optional Google OAuth for login
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Anthropic API key for the AI assistant + strategy generation
# ANTHROPIC_API_KEY=

# CryptoPanic developer key for Market News (free: cryptopanic.com/developers)
# CRYPTOPANIC_API_KEY=

# WalletConnect/Reown project id for the QR/mobile wallet flow (cloud.reown.com);
# injected browser wallets (MetaMask) work without it
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Alchemy Portfolio API key (Phase B wallets) — set the real key in .env.local
# ALCHEMY_API_KEY=

# FRED API key for macro series (free: fred.stlouisfed.org/docs/api/api_key.html).
# Optional — keyless DBnomics fallback covers most series but its BLS mirror
# (CPI, unemployment) lags; fed-balance-sheet and dxy are FRED-only.
# FRED_API_KEY=

# Uniswap Trading API key for trade quoting + execution (Phase C;
# free from the Uniswap developer portal)
# UNISWAP_API_KEY=

# Phase C safety rails: max USD and max % of portfolio per AI trade proposal
# MAX_PROPOSAL_USD=1000
# MAX_PROPOSAL_PCT=25
# Hard leverage cap for AI-proposed Hyperliquid perp orders (default 5).
# MAX_PERP_LEVERAGE=5

# Overrides for the seeded dev user (pnpm db:seed);
# defaults: dev@local.test / password123
# SEED_USER_EMAIL=
# SEED_USER_PASSWORD=

# Hyperliquid info API base override — keyless; unset means mainnet.
# Testnet: https://api.hyperliquid-testnet.xyz
# HYPERLIQUID_API_URL=

# --- Live algo deployments (M2) ---------------------------------------------
# Privy managed signer: bot agent keys are minted inside Privy's enclave and
# are non-exportable — the app holds only these request credentials. All
# unset = live trading disabled, deployments stay paper-only.
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# Base64 PKCS8 P-256 authorization PRIVATE key (owner-locks signature requests).
# PRIVY_AUTHORIZATION_KEY=
# Its PUBLIC key — owner-locks newly created wallets to the key above.
# PRIVY_OWNER_PUBLIC_KEY=
# Privy policy id attached to agent wallets (deny withdraw/transfer actions).
# PRIVY_POLICY_ID=
# Aggregate cap: total live-bot notional as % of account value (default 80).
# MAX_ACCOUNT_EXPOSURE_PCT=80
